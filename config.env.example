# Copy this file to config.env and fill in your values:  cp config.env.example config.env
# (config.env is ignored by git so the community / passwords never get committed)

# ---- SNMP target ----
export SNMP_HOST=192.0.2.1
export SNMP_PORT=161
export SNMP_VERSION=2c
export SNMP_COMMUNITY=change-me
# For SNMPv3 set SNMP_VERSION=3 and enable the line below:
# export SNMP_EXTRA_ARGS="-l authPriv -u <user> -a SHA -A <auth-password> -x AES -X <priv-password>"

# ---- Getting / Providing totals (comma-separated interface names, as shown in the app) ----
# Use sub-interfaces only (e.g. ae3.100), never a parent together with its units, so nothing is counted twice.
# GETTING   = links to upstream providers  -> their INBOUND traffic is counted
# PROVIDING = links to downstream/customers -> their OUTBOUND traffic is counted
# CACHE     = links to cache/CDN servers    -> INBOUND shown separately
# EXCLUDED  = internal links that must never be counted (shown as "excluded")
export GETTING_IFACES="ae3.100,ae3.200"
export PROVIDING_IFACES="ae2.10,ae2.20,ae2.30"
export CACHE_IFACES=""
export EXCLUDED_IFACES=""

# ---- realtime poll interval (seconds) ----
export POLL_INTERVAL=1
# ---- how long to keep raw counters (hours) ----
export RAW_RETENTION_HOURS=48
# ---- how long SQLite keeps the 5-minute staging data (days); the RRD files keep ~2.2 years on their own ----
export AGG_RETENTION_DAYS=800
